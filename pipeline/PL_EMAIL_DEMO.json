{
	"name": "PL_EMAIL_DEMO",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-86.eastus.logic.azure.com:443/workflows/b53e781af79b4720a4c7c514df48b514/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=LcuZZAWq5YtIAaxomeqLwA7dXASLVx5pPAPqVmQBGBQ",
					"body": {
						"value": "@variables('logicapp_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Email Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare_Email_Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare_Email_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logicapp_body",
					"value": {
						"value": "{\n  \"email_address\": \"@{pipeline().parameters.email_address}\",\n  \"subject\": \"@{variables('subject')}\",\n  \"body\": \"@{variables('email_body')}\",\n  \"isHtml\": true\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_Subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "@{toLower(pipeline().parameters.table_name)} Data Ingestion - @{pipeline().parameters.status}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare_Email_UTC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "@concat(\n    '<html><body>',\n    '<p>The table <b>', toLower(pipeline().parameters.table_name),\n    '</b> has been ingested successfully.</p>',\n    '<br>',\n    '<b>Table Name:</b> ', toLower(pipeline().parameters.table_name), '<br>',\n    '<b>Pipeline Name:</b> ', pipeline().Pipeline, '<br>',\n    '<b>Pipeline Run ID:</b> ', pipeline().RunId, '<br>',\n    '<b>Status:</b>', pipeline().parameters.status, '<br>',\n    '<b>Execution Date (UTC):</b> ', variables('utc'), '<br><br>',\n    'Regards,<br>',\n    'ADF Monitoring Team',\n    '</body></html>'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_UTC",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "utc",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"table_name": {
				"type": "string"
			},
			"status": {
				"type": "string"
			},
			"email_address": {
				"type": "string"
			}
		},
		"variables": {
			"logicapp_body": {
				"type": "String"
			},
			"subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			},
			"utc": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-10T08:59:58Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}