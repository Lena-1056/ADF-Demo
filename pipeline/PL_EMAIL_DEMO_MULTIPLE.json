{
	"name": "PL_EMAIL_DEMO_MULTIPLE",
	"properties": {
		"activities": [
			{
				"name": "Send_Email",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Email Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"headers": {
						"Content-Type": "application/json"
					},
					"url": "https://prod-86.eastus.logic.azure.com:443/workflows/b53e781af79b4720a4c7c514df48b514/triggers/When_an_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_an_HTTP_request_is_received%2Frun&sv=1.0&sig=LcuZZAWq5YtIAaxomeqLwA7dXASLVx5pPAPqVmQBGBQ",
					"body": {
						"value": "@variables('logicapp_body')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Email Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare_Email_Subject",
						"dependencyConditions": [
							"Succeeded"
						]
					},
					{
						"activity": "Prepare_Email_Body",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "logicapp_body",
					"value": {
						"value": "{\n  \"email_address\": \"@{pipeline().parameters.email_address}\",\n  \"subject\": \"@{variables('subject')}\",\n  \"body\": \"@{variables('email_body')}\",\n  \"isHtml\": true\n}",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_Subject",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "subject",
					"value": {
						"value": "Ingestion Completed",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_Body",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Prepare_Email_UTC",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "email_body",
					"value": {
						"value": "@concat(\n    '<html><body>',\n    '<h2>ADF Incremental Ingestion Summary</h2>',\n    '<p>Pipeline execution has completed.</p>',\n    '<b>Pipeline Name:</b> ', string(pipeline().Pipeline), '<br>',\n    '<b>Pipeline Run ID:</b> ', string(pipeline().RunId), '<br>',\n    '<b>Execution Date (UTC):</b> ', string(variables('utc')), '<br><br>',\n    '<b>Tables Processed:</b> customers, products, orders<br>',\n    '<b>Overall Status:</b> ', replace(string(pipeline().parameters.table_status),'\"',''), '<br><br>',\n    '<p><b>Regards,</b><br>ADF Monitoring Team</p>',\n    '</body></html>'\n)",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Prepare_Email_UTC",
				"type": "SetVariable",
				"dependsOn": [],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "utc",
					"value": {
						"value": "@utcNow()",
						"type": "Expression"
					}
				}
			}
		],
		"parameters": {
			"email_address": {
				"type": "string"
			},
			"table_status": {
				"type": "array"
			}
		},
		"variables": {
			"logicapp_body": {
				"type": "String"
			},
			"subject": {
				"type": "String"
			},
			"email_body": {
				"type": "String"
			},
			"utc": {
				"type": "String"
			}
		},
		"annotations": [],
		"lastPublishTime": "2026-10-10T10:40:54Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}