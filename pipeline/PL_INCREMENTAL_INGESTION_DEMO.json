				},
				"userProperties": [],
				"typeProperties": {
					"source": {
						"type": "AzureSqlSource",
						"sqlReaderQuery": {
							"value": "SELECT COUNT(*) AS COUNT FROM @{pipeline().parameters.schema}.@{pipeline().parameters.table_name} WHERE created_at > '@{activity('Read Watermark Value').output.firstRow.watermark_value}'",
